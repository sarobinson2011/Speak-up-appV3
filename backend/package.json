{
  "name": "speak-up-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Speak Up anonymous petitions",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "index:petitions": "node src/indexer/runPetitionSync.js",
    "index:membership": "node src/indexer/runMembershipSync.js",
    "index:admission": "node src/indexer/runAdmissionSync.js",
    "index:petitions:loop": "node src/indexer/runPetitionSyncLoop.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}