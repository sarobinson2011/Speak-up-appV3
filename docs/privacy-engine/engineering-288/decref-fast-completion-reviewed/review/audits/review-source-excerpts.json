        "static inline Py_ALWAYS_INLINE int _Py_IsImmortal(PyObject *op)",
        "{",
        "#if SIZEOF_VOID_P > 4",
        "    return _Py_CAST(PY_INT32_T, op->ob_refcnt) < 0;",
        "#else",
        "    return op->ob_refcnt == _Py_IMMORTAL_REFCNT;",
        "#endif",
        "}",
        "#define _Py_IsImmortal(op) _Py_IsImmortal(_PyObject_CAST(op))",
